<odoo>
    <record id="paperformat_survey_certification" model="report.paperformat">
        <field name="name">Survey Certification</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">90</field>
    </record>

    <record id="todo_report" model="ir.actions.report">
        <field name="name">ToDo Report</field>
        <field name="model">todo.task</field>
        <field name="binding_model_id" ref="model_todo_task"/>
        <field name="binding_type">report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">todo_task.todo_report_template</field>
        <field name="paperformat_id" ref="todo_task.paperformat_survey_certification"/>
    </record>

    <template id="todo_custom_layout">
        <div class="header">
            <div style="border-bottom: 1px solid #000; padding-bottom: 10px;">
                <!--                <t t-set="employee" t-value="o.assign_to_id"/>-->
                <!--                <t t-if="employee.company_id.logo">-->
                <!--                    <img t-att-src="image_data_uri(employee.company_id.logo)"-->
                <!--                         style="max-height: 40pt; max-width: 100%;" alt="Company Logo"/>-->
                <!--                </t>-->
                <!--                <t t-if="not employee.company_id.logo">-->
                <!--                    <strong>Moamen Company</strong>-->
                <!--                </t>-->
                <img src="/todo_task/static/src/img/logo.png"
                     style="max-height: 40pt; max-width: 100%;" alt="Company Logo"/>
                <br/>
                Alexandria, Egypt
                <br/>
                0111444888
            </div>
        </div>

        <div class="article">
            <t t-out="0"/>
        </div>

        <div class="footer">
            <div style="border-top: 1px solid #000; padding-top: 10px; width: 100%; display: flex; justify-content: space-between;">
                <span>moamencompany@gmail.com, 0111444888, register number</span>
                <span>Page
                    <span class="page"/>
                    /
                    <span class="topage"/>
                </span>
            </div>
        </div>
    </template>

    <template id="todo_report_template">
        <t t-call="web.html_container">
            <t t-call="todo_task.todo_custom_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <style>
                            table {
                            width: 100%;
                            border-collapse: collapse;
                            margin-top: 20px;
                            font-family: Arial, sans-serif;
                            font-size: 13px;
                            color: #333;
                            }
                            table th, table td {
                            border: 1px solid #ccc;
                            padding: 10px;
                            text-align: left;
                            }
                            table th {
                            background-color: #f2f2f2;
                            }
                            .label-cell {
                            font-weight: bold;
                            background-color: #f9f9f9;
                            text-align: center;
                            }
                            .value-cell {
                            text-align: center;
                            }
                        </style>

                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Task:
                                    <span t-field="o.name"/>
                                </strong>
                                <br/>
                                <strong>Due Date:</strong>
                                <span t-field="o.due_date"/>
                                <br/>
                                <strong>Assign To:</strong>
                                <span t-field="o.assign_to_id"/>
                                <br/>
                                <strong>Estimated Time:</strong>
                                <span t-field="o.estimated_time"/>
                                H
                            </div>
                        </div>
                        <div class="row mt-4">
                            <div class="col-12">
                                <strong>Description:</strong>
                                <br/>
                                <p t-field="o.description"/>
                            </div>
                        </div>
                        <table>
                            <thead>
                                <tr>
                                    <th colspan="4" class="text-center">
                                        <strong>Timesheet</strong>
                                    </th>
                                </tr>
                                <tr>
                                    <th class="text-center">#</th>
                                    <th class="text-center">Date</th>
                                    <th class="text-center">Description</th>
                                    <th class="text-center">Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.todo_line_ids" t-as="rec">
                                    <tr>
                                        <td class="text-center">
                                            <span t-esc="rec_index + 1"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="rec.date"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="rec.description"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="rec.working_time"/>
                                            H
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-center">
                                        <strong>Total Time</strong>
                                    </td>
                                    <td class="text-center">
                                        <strong>
                                            <span t-esc="sum(o.todo_line_ids.mapped('working_time'))"/>
                                            H
                                        </strong>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                        <br/>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
