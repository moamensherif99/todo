<odoo>
    <record id="assign_task_wizard_view_form" model="ir.ui.view">
        <field name="name">assign task wizard form</field>
        <field name="model">assign.task</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="assign_to_id"/>
                    <field name="todo_ids" widget="many2many_tags" invisible="1"/>
                </group>
                <footer>
                    <button name="action_assign_tasks" string="Assign" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_assign_task_wizard" model="ir.actions.act_window">
        <field name="name">Assign Tasks</field>
        <field name="res_model">assign.task</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_todo_task"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
